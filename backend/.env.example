# Copy to backend/.env and fill in. The server checks these at start-up and names any
# missing or invalid key (values are never printed).

NODE_ENV=development
PORT=3000
# MongoDB Atlas (a replica set, so transactions work) or a local replica set:
# mongodb://127.0.0.1:27017/crm?replicaSet=rs0
MONGO_URI=mongodb://127.0.0.1:27017/crm?replicaSet=rs0

# Public address of this server; invite links and uploaded-file URLs use it.
PUBLIC_URL=http://127.0.0.1:3000
# Optional. Defaults to PUBLIC_URL/crm/frontend (the backend serves the pages).
FRONTEND_URL=http://127.0.0.1:3000/crm/frontend

# Sign-in. JWT_SECRET: at least 16 characters (32+ in production).
JWT_SECRET=replace-with-a-long-random-secret
# Access token lifetime (e.g. 15m, 1h) and refresh token lifetime in days.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
# Optional. Defaults to PUBLIC_URL/api/v1/gmail/oauth/callback.
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/api/v1/gmail/oauth/callback

# Encryption for stored secrets (Gmail tokens today; WhatsApp/IndiaMART/payment keys later).
# GMAIL_TOKEN_ENCRYPTION_KEY stays so existing Gmail connections remain readable.
# DATA_ENCRYPTION_KEY is used for everything written from now on (required in production, 32+ chars).
GMAIL_TOKEN_ENCRYPTION_KEY=replace-with-a-long-random-secret
DATA_ENCRYPTION_KEY=replace-with-another-long-random-secret

UPLOAD_DIR=uploads

# Optional. Private folder for Documents (never served publicly; download needs sign-in)
# and the largest file size in MB (1-100).
DOCUMENT_DIR=storage/documents
DOCUMENT_MAX_MB=10

# Optional. Extra browser origins allowed to call the API, comma-separated.
# Development already allows 127.0.0.1/localhost on ports 3000, 5500 and 5501.
CORS_ORIGINS=
# Optional. Requests per minute per IP.
RATE_LIMIT_API_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_MINUTE=20
