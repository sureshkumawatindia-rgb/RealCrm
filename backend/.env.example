# Copy to backend/.env and fill in. The server checks these at start-up and names any
# missing or invalid key (values are never printed).

NODE_ENV=development
PORT=3000
# MongoDB Atlas (a replica set, so transactions work) or a local replica set:
# mongodb://127.0.0.1:27017/crm?replicaSet=rs0
MONGO_URI=mongodb://127.0.0.1:27017/crm?replicaSet=rs0

# Public address of this server; invite links and uploaded-file URLs use it.
PUBLIC_URL=http://127.0.0.1:3000
# Optional. Defaults to PUBLIC_URL/crm/frontend (the backend serves the pages).
FRONTEND_URL=http://127.0.0.1:3000/crm/frontend

# Sign-in. JWT_SECRET: at least 16 characters (32+ in production). Customers' quotation links
# (/q/...) are signed with a key made from it: changing it makes earlier links stop working.
JWT_SECRET=replace-with-a-long-random-secret
# Access token lifetime (e.g. 15m, 1h) and refresh token lifetime in days.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
# Optional. Defaults to PUBLIC_URL/api/v1/gmail/oauth/callback.
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/api/v1/gmail/oauth/callback

# Encryption for stored secrets (Gmail tokens today; WhatsApp/IndiaMART/payment keys later).
# GMAIL_TOKEN_ENCRYPTION_KEY stays so existing Gmail connections remain readable.
# DATA_ENCRYPTION_KEY is used for everything written from now on (required in production, 32+ chars).
GMAIL_TOKEN_ENCRYPTION_KEY=replace-with-a-long-random-secret
DATA_ENCRYPTION_KEY=replace-with-another-long-random-secret

UPLOAD_DIR=uploads

# Optional. Private folder for Documents (never served publicly; download needs sign-in)
# and the largest file size in MB (1-100).
DOCUMENT_DIR=storage/documents
DOCUMENT_MAX_MB=10

# Optional. WhatsApp Cloud API (see docs/WHATSAPP_SETUP.md). Numbers and tokens are added in
# Settings → WhatsApp, not here. Keep the Graph API version current.
WHATSAPP_GRAPH_VERSION=v26.0
# WHATSAPP_GRAPH_URL=https://graph.facebook.com
# RATE_LIMIT_WEBHOOK_PER_MINUTE=1200

# Optional. IndiaMART CRM Pull API address (keys are added in Settings → Lead sources).
# INDIAMART_PULL_URL=https://mapi.indiamart.com/wservce/crm/crmListing/v2/

# Optional. Behind a reverse proxy or hosting platform (docs/DEPLOYMENT.md): how many proxies to
# trust for the client's address and https. 0 on this computer.
# TRUST_PROXY=1
# Optional. Days a company asked to be deleted keeps working before its data is removed.
# ORG_DELETION_GRACE_DAYS=7

# Optional. Extra browser origins allowed to call the API, comma-separated.
# Development already allows 127.0.0.1/localhost on ports 3000, 5500 and 5501.
CORS_ORIGINS=
# Optional. Requests per minute per IP.
RATE_LIMIT_API_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_MINUTE=20
# Website enquiry forms (Settings → Lead sources): enquiries per minute from one address.
RATE_LIMIT_FORM_PER_MINUTE=10
# Public API (docs/INTEGRATIONS.md): requests per minute per API key.
RATE_LIMIT_PUBLIC_API_PER_MINUTE=120

# Optional. Selling the CRM plans (Phase 10, docs/BILLING_SETUP.md): companies pay the platform
# through Razorpay Subscriptions on the platform's own account. mock = a test checkout page on
# this server (development default, never in production); off = no online payment (production
# default until Razorpay is set up).
# BILLING_PROVIDER=razorpay
# RAZORPAY_BILLING_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# RAZORPAY_BILLING_KEY_SECRET=
# RAZORPAY_BILLING_WEBHOOK_SECRET=
# Who issues the plan invoices (GST tax invoice). The state comes from the GSTIN. Confirm the SAC with your CA.
# BILLING_SELLER_NAME=
# BILLING_SELLER_GSTIN=
# BILLING_SELLER_ADDRESS=
# BILLING_SELLER_EMAIL=
# BILLING_SAC=998315
# BILLING_INVOICE_PREFIX=YC

# Optional. The AI assistant (Phase 10D, docs/AI_ASSISTANT.md) on the platform's own Claude API
# key; without it the assistant is not offered. Budget per company per month in US dollars
# (estimated from list prices). Models default to claude-sonnet-5-5 (suggestions) and
# claude-haiku-4-5 (answers by itself).
# ANTHROPIC_API_KEY=
# AI_MONTHLY_BUDGET_USD=5
# AI_SUGGEST_MODEL=
# AI_AUTOREPLY_MODEL=
# AI_REFUSAL_FALLBACK=default

# Optional. Web push for the bell's notes (Phase 10E). Without keys, a key pair is made once and
# kept in the database. VAPID_SUBJECT: a mailto: or https: address of the platform (your
# PUBLIC_URL when it is https).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@yourdomain.in

# Optional. Sign-in with a WhatsApp code (Phase 10E, docs/WHATSAPP_SETUP.md): the platform's own
# WhatsApp number and an approved AUTHENTICATION template (copy-code button). mock = development
# (the code is shown on screen), off = production default until set up.
# OTP_PROVIDER=whatsapp
# WHATSAPP_OTP_PHONE_NUMBER_ID=
# WHATSAPP_OTP_ACCESS_TOKEN=
# WHATSAPP_OTP_TEMPLATE=crm_login_code
# WHATSAPP_OTP_LANGUAGE=en
